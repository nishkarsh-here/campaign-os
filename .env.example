# =====================================================================
#  campaign-os — example environment
#  Copy to backend/.env. Never commit the real file.
#
#  Everything below has a default that keeps the app fully runnable with
#  ZERO external API keys: all providers default to `mock`, storage to
#  local disk. That is a hard requirement, not a convenience — the demo
#  must survive a dead key and a bad network.
#
#  Sections are marked:
#    [required]     must be set for any deployment
#    [optional]     safe to leave at the default
#    [development]  local convenience; do not set in production
#    [demo]         the demonstration path
#    [provider]     only needed when that provider is selected
# =====================================================================

# --- runtime ---------------------------------------------------- [required]
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO                      # [optional] DEBUG in development
API_HOST=127.0.0.1                  # [optional] 0.0.0.0 in a container
API_PORT=8000                       # [optional] most hosts inject $PORT
# Comma-separated. The browser origin your frontend is served from.
CORS_ORIGINS=http://localhost:3000

# --- database ----------------------------------------------------- [required]
# PostgreSQL 16+ with the pgcrypto, citext and vector extensions available.
# Two DSNs for one database: SQLAlchemy needs the async driver, and the
# LangGraph checkpointer talks to psycopg directly and does not understand
# SQLAlchemy's "+driver" form. Alembic derives its own URL from the sync one.
DATABASE_URL=postgresql+asyncpg://localhost:5432/campaign_os
DATABASE_URL_SYNC=postgresql://localhost:5432/campaign_os

# --- provider selection ------------------------------------------- [required]
# The only place a provider is chosen. Nothing else in the codebase reads
# these; `app/providers/registry.py` turns them into adapters.
# Only `mock` and `gemini` are built. The other names below are accepted by
# the registry and then fail at startup with "no module" — they are interface
# seams, not working adapters. See README "Status".
LLM_PROVIDER=mock                   # mock | gemini
IMAGE_PROVIDER=mock                 # mock | gemini      (leonardo: not built)
EMBEDDING_PROVIDER=mock             # mock | gemini
STORAGE_PROVIDER=local              # local              (supabase: not built)
SEARCH_PROVIDER=none                # none               (tavily: not built)

# Fan generation out across several providers to compare them. Empty means
# "just IMAGE_PROVIDER", so a single-provider setup needs nothing here.
IMAGE_PROVIDERS=                    # [optional] e.g. mock,gemini
# Plates per provider per batch. One by default: the point of multi-provider
# generation is comparing providers, and four near-identical plates from each
# is spend without information.
GENERATION_IMAGES_PER_JOB=1         # [optional] 1-4

# --- demo ------------------------------------------------------------- [demo]
# Declares this instance a demonstration. Enforced, not cosmetic: startup
# refuses if any provider is not `mock`, so a demo cannot depend on an
# external service. Surfaced on /v1/health and shown as a badge in the UI.
DEMO_MODE=false

# --- provider credentials ----------------------------------------- [provider]
# Server-side only. None of these ever reaches the browser bundle — the
# frontend talks only to our API.
GEMINI_API_KEY=
# Reasoning (text + multimodal). Stable ids only: a `-preview` or `-latest`
# alias can change under you between two runs of the same campaign.
GEMINI_LLM_MODEL=gemini-3.8-flash
# Image generation is a separate capability on a separate cadence — changing
# the reasoning model above must never change what draws the plate.
# Nano Banana 2. `gemini-2.5-flash-image` is the legacy model.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Vector width asked of the embedding API. Must equal the width of
# `brand_chunks.embedding`; startup refuses if it does not. Changing it needs
# a migration and a re-embed, not just a new number here.
GEMINI_EMBEDDING_DIMENSIONS=1536

# Not implemented. `IMAGE_PROVIDER=leonardo` fails at startup — there is no
# `app/providers/leonardo/` in this build.
LEONARDO_API_KEY=
LEONARDO_MODEL_ID=

# Not implemented. `SEARCH_PROVIDER=tavily` fails at startup for the same
# reason; `none` is the only search provider this build has.
TAVILY_API_KEY=

# --- storage ------------------------------------------------------ [required]
# Local disk. Fine for a single instance; use Supabase for anything with more
# than one, since local storage is not shared between them.
LOCAL_STORAGE_DIR=./storage

SUPABASE_URL=                       # [provider] AUTH_PROVIDER or STORAGE_PROVIDER=supabase
# Publishable (anon) key. Identifies the project when verifying a caller's own
# token; carries no privilege, and is safe in a browser bundle.
SUPABASE_ANON_KEY=                  # [provider] AUTH_PROVIDER=supabase
SUPABASE_SERVICE_ROLE_KEY=          # [provider] server-side ONLY — storage, never auth
SUPABASE_STORAGE_BUCKET=campaign-assets

# --- auth ---------------------------------------------------------- [required]
# `dev_stub` authenticates every caller as the same user. It REFUSES to
# construct when APP_ENV=production — that is a hard guard, not a convention.
AUTH_PROVIDER=dev_stub              # dev_stub | supabase
DEV_STUB_USER_EMAIL=demo@campaign-os.local   # [development]
DEV_STUB_ORG_SLUG=demo-org                   # [development]

# --- media links ---------------------------------- [required in production]
# A browser cannot put Authorization or X-Organization-Id on an <img src>, so
# byte-serving routes also accept a short-lived signed link naming exactly one
# row. This is the key those links are signed with.
#
# Leave it blank and the process generates one at startup: no configuration for
# the offline demo, and no shipped default that is the same on every install.
# SET IT IN PRODUCTION — two instances with two generated keys reject each
# other's links, so images would load or not depending on which one answered.
# The app refuses to start without it when APP_ENV=production.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIA_URL_SECRET=
# How long a media link lives, in seconds. Long enough to render a page and
# open an image in a new tab; short enough that one caught in a log or a
# referrer header is worthless by the time anyone reads it. 30s - 24h.
MEDIA_URL_TTL_S=900

# --- limits and safety --------------------------------------------- [optional]
MAX_UPLOAD_MB=15
ALLOWED_UPLOAD_MIME=image/png,image/jpeg,image/webp,application/pdf
GENERATION_TIMEOUT_S=120
# Extra attempts after a RETRYABLE image failure (timeout, rate limit, 5xx).
# Every attempt is billable, so this is deliberately small and capped at 3.
# A refusal or a bad request is never retried — the answer would be the same.
IMAGE_MAX_RETRIES=1
LLM_TIMEOUT_S=60
# Revision iterations. Separate from the interview budget, so a long interview
# cannot exhaust the ability to revise.
MAX_GRAPH_ITERATIONS=8
# Hard cap on interview questions. An interview that will not end is worse
# than one that proceeds on stated assumptions.
MAX_INTERVIEW_TURNS=8

# --- langgraph ---------------------------------------------------- [no knob]
# There is deliberately no variable here. Checkpoint deserialization is
# restricted to the types allowlisted in app/graph/serde.py, unconditionally
# and by construction — `LANGGRAPH_STRICT_MSGPACK` is NOT read, and setting it
# in this file never worked (pydantic-settings loads .env into Settings, not
# into os.environ). See the note in app/graph/serde.py:build_serde.

# --- mock provider behaviour ------------------------------------ [development]
# Force the mocks to fail, so error paths are exercised on demand rather than
# assumed. Never set this to anything but `none` during a demonstration.
MOCK_FAILURE_MODE=none              # none|timeout|malformed|rate_limit|unavailable|blocked
# Artificial delay per mock generation. A second or two locally makes the
# PENDING -> RUNNING -> COMPLETED transitions visible instead of everything
# finishing before the first poll.
MOCK_IMAGE_LATENCY_SECONDS=0

# --- observability -------------------------------------------------- [optional]
SENTRY_DSN=
